# Production settings. Copy to .env on the server, fill in every value marked CHANGE, then
# run `php artisan key:generate` once. See deploy/README.md.

APP_NAME="Vasuttam PMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# CHANGE: the public HTTPS address (links in e-mails, payment links, booking engine).
APP_URL=https://pms.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Behind a load balancer / Cloudflare / a reverse proxy: "*" or its addresses, comma separated.
TRUSTED_PROXIES=

# Daily log files, and errors to Slack (create an incoming webhook for an #alerts channel).
LOG_CHANNEL=stack
LOG_STACK=daily,slack
LOG_DAILY_DAYS=30
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="PMS alerts"
LOG_SLACK_LEVEL=error

# CHANGE: MySQL 8 / MariaDB 10.6+ (or pgsql). Not SQLite in production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_booking
DB_USERNAME=hotel_booking
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queued e-mails, reports and channel-manager jobs: run the worker (deploy/supervisor.conf).
QUEUE_CONNECTION=database
CACHE_STORE=database

# CHANGE: outgoing e-mail (Amazon SES, Postmark, SendGrid, Zoho, Gmail Workspace SMTP relay...).
# Check it with: php artisan ops:mail-test you@example.com
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="reservations@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment gateways (live keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=production

# Booking engine requests a minute, per visitor IP and property.
BOOKING_ENGINE_QUOTE_PER_MINUTE=60
BOOKING_ENGINE_CHECKOUT_PER_MINUTE=15

# Channel manager (Channex): production key and URL.
CHANNEX_API_KEY=
CHANNEX_BASE_URL=https://app.channex.io/api/v1
CHANNEX_APP_URL=https://app.channex.io

# Backups (php artisan ops:backup runs nightly at 01:30) go to the off-server "backups" disk:
# a private S3-compatible bucket (AWS S3, Wasabi, Cloudflare R2, Backblaze B2...). CHANGE.
# Give its key write and list rights on that bucket only, and turn on bucket versioning.
BACKUP_DISK=backups
BACKUP_KEEP_DAYS=14
BACKUP_INCLUDE_FILES=true
BACKUP_DUMP_BINARY_PATH=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=ap-south-1
BACKUP_AWS_BUCKET=
# For non-AWS stores, e.g. https://<account>.r2.cloudflarestorage.com, with path-style true.
BACKUP_AWS_ENDPOINT=
BACKUP_AWS_USE_PATH_STYLE_ENDPOINT=false

# Error tracking: create a Laravel project in Sentry (sentry.io or self-hosted) and paste its DSN.
# Guests' personal data is not sent (SENTRY_SEND_DEFAULT_PII=false).
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# Monitoring: alerts by e-mail, and the token that shows the checks on /health.
OPS_ALERT_EMAIL=
HEALTH_CHECK_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# "Continue with Google" sign-in (Google Cloud OAuth client); empty hides the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# PDFs (invoices, prints, reports): Puppeteer with Chrome. deploy/deploy.sh installs Chrome and
# sets LARAVEL_PDF_CHROME_PATH; leave it empty here. NO_SANDBOX only when Chrome can't start its
# sandbox (check with: php artisan ops:pdf-check).
LARAVEL_PDF_CHROME_PATH=
LARAVEL_PDF_NO_SANDBOX=false
